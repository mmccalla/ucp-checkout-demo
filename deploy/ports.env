# Loopback service layout (DM-26 option (a)). All services bind 127.0.0.1 only.
# Public (TLS 1.3, Caddy):  Platform https://localhost:8443   Business https://localhost:9443
LOOPBACK_HOST=127.0.0.1
CADDY_ADMIN_PORT=2019
PLATFORM_TLS_PORT=8443
BUSINESS_TLS_PORT=9443
PLATFORM_APP_PORT=8101
BUSINESS_APP_PORT=8201
PSP_MOCK_APP_PORT=8301
# Jaeger 2.22.0 release binary (T-106, tools/jaeger.sh). No UCP profile fetch.
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
